<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

    <!-- Main Product Definition -->
    <Product Id="*"
             Name="PrintHero"
             Language="1033"
             Version="1.0.0.0"
             Manufacturer="PrintHero"
             UpgradeCode="12345678-1234-1234-1234-123456789012">

        <!-- Package Information -->
        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="PrintHero - Automatic PDF Printer"
                 Comments="Complete PDF printing and monitoring solution"
                 Manufacturer="PrintHero"
                 Platform="x64"
                 InstallPrivileges="elevated"
                 AdminImage="no"
                 ReadOnly="no" />

        <!-- Upgrade Logic -->
        <MajorUpgrade DowngradeErrorMessage="A newer version of PrintHero is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Admin Rights Check -->
        <Condition Message="This application requires administrator privileges to install. Please right-click the installer and select 'Run as administrator'.">
            <![CDATA[Privileged]]>
        </Condition>

        <!-- Custom Properties -->
        <Property Id="ARPPRODUCTICON" Value="PrintHeroIcon.exe" />
        <Property Id="ARPNOREPAIR" Value="1" />

        <!-- Features -->
        <Feature Id="CoreFeature" Title="PrintHero Core Application" Level="1" Description="Main PrintHero application components">
            <ComponentRef Id="MainAppFiles" />
            <ComponentRef Id="CoreRuntimeFiles" />
            <ComponentRef Id="WpfRuntimeFiles" />
            <ComponentRef Id="WindowsFormsFiles" />
            <ComponentRef Id="ExtensionsFiles" />
            <ComponentRef Id="ServiceManagementFiles" />
            <ComponentRef Id="NativeRuntimeFiles" />
            <ComponentRef Id="AdditionalRuntimeFiles" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <Feature Id="DesktopShortcut" Title="Desktop Shortcut" Level="1" Description="Create desktop shortcut">
            <ComponentRef Id="DesktopShortcut" />
        </Feature>

        <Feature Id="AutoStartup" Title="Auto-start with Windows" Level="1" Description="Automatically start PrintHero when Windows starts">
            <ComponentRef Id="AutoStartupRegistry" />
        </Feature>

        <!-- UI Configuration -->
        <UIRef Id="WixUI_InstallDir" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

        <!-- Custom Icons -->
        <Icon Id="PrintHeroIcon.exe" SourceFile="..\\PrintHero.UI\\bin\\Release\\net8.0-windows\\win-x64\\PrintHero.UI.exe" />

    </Product>

    <!-- Directory Structure -->
    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
