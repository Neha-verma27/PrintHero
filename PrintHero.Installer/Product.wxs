                <File Id="SystemPrivateXmlLinq" Source="..\\PrintHero.UI\\bin\\Release\\net8.0-windows\\win-x64\\System.Private.Xml.Linq.dll" />
            </Component>
        </DirectoryRef>
    </Fragment>

    <!-- Start Menu Shortcuts -->
    <Fragment>
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="99999999-9999-9999-9999-999999999999" Win64="yes">
                <Shortcut Id="StartMenuPrintHero"
                          Name="PrintHero"
                          Description="PrintHero - Automatic PDF Printer"
                          Target="[INSTALLFOLDER]PrintHero.UI.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="PrintHeroIcon.exe" />
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\PrintHero\Installed"
                               Name="startmenu"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>
    </Fragment>

    <!-- Desktop Shortcut -->
    <Fragment>
        <DirectoryRef Id="DesktopFolder">
            <Component Id="DesktopShortcut" Guid="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" Win64="yes">
                <Shortcut Id="DesktopShortcut"
                          Name="PrintHero"
                          Description="PrintHero - Automatic PDF Printer"
                          Target="[INSTALLFOLDER]PrintHero.UI.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="PrintHeroIcon.exe" />
                <RegistryValue Root="HKCU"
                               Key="Software\PrintHero\Desktop"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>
    </Fragment>

    <!-- Auto-startup Registry Entry -->
    <Fragment>
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="AutoStartupRegistry" Guid="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb" Win64="yes">
                <RegistryValue Root="HKCU"
                               Key="Software\Microsoft\Windows\CurrentVersion\Run"
                               Name="PrintHero"
                               Type="string"
                               Value="&quot;[INSTALLFOLDER]PrintHero.UI.exe&quot; -minimized"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>
    </Fragment>

</Wix>