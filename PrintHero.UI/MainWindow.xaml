<Window x:Class="PrintHero.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintHero"
        Height="750"
        Width="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#E5E7EB"
        WindowStyle="SingleBorderWindow"
        Icon="/Resources/PrintHero.ico">

    <Window.Resources>
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="SwitchTrack"
                                    Width="40"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#D1D5DB"
                                    HorizontalAlignment="Center"/>
                            <Border x:Name="SwitchThumb"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,2,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.2"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- OFF Text -->
                            <TextBlock x:Name="OffText"
                                      Text="Off"
                                      FontSize="9"
                                      Foreground="#6B7280"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Opacity="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                          Storyboard.TargetProperty="Background.Color"
                                                          To="#10B981" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="20" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="OffText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                          Storyboard.TargetProperty="Background.Color"
                                                          To="#D1D5DB" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="OffText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Container -->
    <Border Background="White" CornerRadius="16" Margin="0,0,0,-6" 
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#9CA3AF" BlurRadius="30" ShadowDepth="8" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Navigation Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,25" Background="#F9FAFB">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏠 Home" Foreground="Black" FontSize="13" Margin="0,0,25,0"/>
                    <TextBlock Text="Support" Foreground="Black" FontSize="13" Margin="0,0,25,0"/>
                    <TextBlock Text="Activate License" Foreground="Black" FontSize="13"/>
                </StackPanel>

                <!-- PrintHero Logo -->
                <Image Grid.Column="2" Source="pack://application:,,,/PrintHero.UI;component/Resources/PrintHero_Logo1.png" 
                       Height="32" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Welcome Header -->
            <TextBlock Grid.Row="1" 
                      FontSize="28" FontWeight="SemiBold" 
                      Foreground="#111827" Margin="0,0,0,30"><Run Text="Welcome, "/><Run Language="en-sg" Text="User"/></TextBlock>

            <!-- Statistics Cards Row -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,35">
                <!-- Toggle Switch Card -->
                <Border Background="White" CornerRadius="10" Margin="34,0,6,0" 
                        BorderBrush="#F3F4F6" BorderThickness="1" Height="90">
                    <Border.Effect>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <CheckBox x:Name="PowerToggle"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 Checked="PowerToggle_Checked"
                                 Unchecked="PowerToggle_Unchecked"
                                 HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Tile for switch" FontSize="10" 
                                  Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Files Printed Card -->
                <Border Background="White" CornerRadius="10" Margin="34,0,0,0" 
                        BorderBrush="#F3F4F6" BorderThickness="1" Height="90">
                    <Border.Effect>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FilesProcessedToday, FallbackValue=45}" 
                                  FontSize="36" FontWeight="Bold" 
                                  Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Files Printed" FontSize="10" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Printing Errors Card -->
                <Border Background="White" CornerRadius="10" Margin="34,0,-2,0" 
                        BorderBrush="#F3F4F6" BorderThickness="1" Height="90">
                    <Border.Effect>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PrintingErrorsToday, FallbackValue=33}" 
                                  FontSize="36" FontWeight="Bold" 
                                  Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Printing errors" FontSize="10" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total Printing Card -->
                <Border Background="White" CornerRadius="10" 
                        BorderBrush="#F3F4F6" BorderThickness="1" Height="90" Margin="40,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalPrinting, FallbackValue=78}" 
                                  FontSize="36" FontWeight="Bold" 
                                  Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#374151" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Printing" FontSize="10" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Print Jobs Section -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Print Jobs Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Print Jobs" 
                              FontSize="20" FontWeight="SemiBold" 
                              Foreground="#111827" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="+ Add Job"
                           Background="#DC2626" Foreground="White" 
                           BorderThickness="0" Padding="16,8" 
                           FontSize="13" FontWeight="SemiBold"
                           Click="AddPrintJob_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Print Jobs List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding PrintJobConfigurations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" 
                                    BorderBrush="#F3F4F6" BorderThickness="1" 
                                    Margin="0,0,0,8" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E5E7EB" BlurRadius="3" ShadowDepth="1" Opacity="0.2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Circle -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8" 
                                            Fill="#10B981" VerticalAlignment="Center" 
                                            Margin="0,0,12,0"/>

                                    <!-- Files Printed Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Files Printed" FontSize="13" 
                                                  FontWeight="SemiBold" Foreground="#111827" 
                                                  Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding JobName}" FontSize="11" 
                                                  Foreground="#6B7280"/>
                                    </StackPanel>

                                    <!-- Hot Folder Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Hot folder" FontSize="13" 
                                                  FontWeight="SemiBold" Foreground="#111827" 
                                                  Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding HotFolderPath}" FontSize="11" 
                                                  Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Printer Info -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Printer" FontSize="13" 
                                                  FontWeight="SemiBold" Foreground="#111827" 
                                                  Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding PrinterName}" FontSize="11" 
                                                  Foreground="#6B7280"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" 
                                               VerticalAlignment="Center">
                                        <!-- Open Folder Button -->
                                        <Button Background="Transparent" BorderThickness="0" 
                                               Width="28" Height="28" Margin="0,0,6,0" 
                                               Cursor="Hand" Click="OpenHotFolder_Click"
                                               ToolTip="Open Hot Folder">
                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" 
                                                   CornerRadius="4" Width="20" Height="20">
                                                <TextBlock Text="📁" FontSize="12" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                        <!-- Delete Button -->
                                        <Button Background="Transparent" BorderThickness="0" 
                                               Width="28" Height="28" Cursor="Hand"
                                               Click="RemovePrintJob_Click"
                                               ToolTip="Delete Print Job">
                                            <Border BorderBrush="#FCA5A5" BorderThickness="1" 
                                                   CornerRadius="4" Width="20" Height="20">
                                                <TextBlock Text="🗑" FontSize="12" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>