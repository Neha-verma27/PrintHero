<Window x:Class="PrintHero.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintHero"
        Height="600"
        Width="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        WindowStyle="ThreeDBorderWindow"
        Icon="/Resources/PrintHero.ico">

    <Window.Resources>
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="SwitchTrack"
                                    Width="60"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#CCCCCC"
                                    HorizontalAlignment="Left"/>
                            <Border x:Name="SwitchThumb"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,2,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- ON Text -->
                            <TextBlock x:Name="OnText"
                                      Text="ON"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="White"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Opacity="0"/>
                            <!-- OFF Text -->
                            <TextBlock x:Name="OffText"
                                      Text="OFF"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="#FFE74C3C"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="30,0,25,0"
                                      Opacity="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                          Storyboard.TargetProperty="Background.Color"
                                                          To="#4CAF50" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="32" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="OnText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="OffText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                          Storyboard.TargetProperty="Background.Color"
                                                          To="#CCCCCC" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="OnText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="OffText"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Button Style -->
        <Style x:Key="Button3DStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E0E0E0" Offset="0"/>
                        <GradientStop Color="#C5C5C5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D5D5D5" Offset="0"/>
                                            <GradientStop Color="#B8B8B8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
        </Style>

    </Window.Resources>

    <!-- Main Container with Border -->
    <Border Background="#E8E8E8" 
            BorderBrush="#999999" 
            BorderThickness="2" 
            CornerRadius="8"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <!-- Header Section with Logo -->
            <Grid Height="80" VerticalAlignment="Top" Margin="15,15,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Centered Logo Only -->
                <Image Source="/PrintHero.UI;component/Resources/printhero-logo.png"
                       Width="80" Height="60"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>
            </Grid>

            <!-- Main Content Area -->
            <Grid Margin="50,110,50,70">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Toggle and Stats Section -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Power Toggle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="PowerToggle"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 Checked="PowerToggle_Checked"
                                 Unchecked="PowerToggle_Unchecked"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>
                    
                    <!-- Files Printed Stats -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Files Printed"
                                  FontSize="14"
                                  Foreground="#666666"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding FilesProcessedToday, Mode=OneWay, FallbackValue=0}"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Printing Errors Stats -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Printing Errors"
                                  FontSize="14"
                                  Foreground="#666666"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PrintingErrorsToday, Mode=OneWay, FallbackValue=0}"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  Foreground="#E74C3C"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>



                <!-- Print Jobs Section -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Print Jobs Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                  Text="Print Jobs" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#333333" 
                                  VerticalAlignment="Center"/>
                                  
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+"
                                   Background="#4CAF50"
                                   Foreground="White"
                                   BorderBrush="#4CAF50"
                                   BorderThickness="2"
                                   Width="30"
                                   Height="30"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,10,0"
                                   Click="AddPrintJob_Click"
                                   ToolTip="Add Print Job"/>
                            <Button Content="−"
                                   Background="#F44336"
                                   Foreground="White"
                                   BorderBrush="#F44336"
                                   BorderThickness="2"
                                   Width="30"
                                   Height="30"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Click="RemovePrintJob_Click"
                                   ToolTip="Remove Print Job"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Print Jobs DataGrid -->
                    <DataGrid Grid.Row="1" 
                             x:Name="PrintJobsGrid"
                             ItemsSource="{Binding PrintJobConfigurations}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             CanUserReorderColumns="False"
                             CanUserResizeRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             Background="White"
                             BorderBrush="#CCCCCC"
                             BorderThickness="2"
                             RowHeight="45"
                             FontSize="13"
                             SelectionMode="Single">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job Name" 
                                               Binding="{Binding DisplayName}" 
                                               Width="200"
                                               HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                            <DataGridTextColumn Header="Hot Folder" 
                                               Binding="{Binding HotFolderPath}" 
                                               Width="2*"
                                               HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                            <DataGridTextColumn Header="Printer" 
                                               Binding="{Binding PrinterName}" 
                                               Width="*"
                                               HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                        </DataGrid.Columns>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Height" Value="45"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Footer -->
            <TextBlock Text="PrintHero v1.0. 2025 Copyright."
                      FontSize="10"
                      Foreground="#999999"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,15"/>
        </Grid>
    </Border>
</Window>