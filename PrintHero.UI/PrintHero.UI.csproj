<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyTitle>PrintHero</AssemblyTitle>
		<AssemblyDescription>Automatic PDF printing service</AssemblyDescription>
		<ApplicationIcon>Resources\PrintHero.ico</ApplicationIcon>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<!-- Ensure Release configuration works -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<PublishReadyToRun>false</PublishReadyToRun>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
	</PropertyGroup>


	<ItemGroup>
	  <None Remove="Resources\printhero-logo.png" />
	  <None Remove="Resources\PrintHero.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.6" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.6" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.6" />
		<PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="6.0.0" />
		<PackageReference Include="System.Text.Json" Version="9.0.6" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PrintHero.Core\PrintHero.Core.csproj" />
		<ProjectReference Include="..\PrintHero.Service\PrintHero.Service.csproj" />
	</ItemGroup>

	<!-- Ensure native libraries are copied to output -->
	<Target Name="CopyPdfiumNativeLibs" AfterTargets="Build">
		<ItemGroup>
			<PdfiumFiles Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\**\pdfium.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(PdfiumFiles)" DestinationFolder="$(OutputPath)x64" SkipUnchangedFiles="true" Condition="Exists('%(PdfiumFiles.FullPath)')" ContinueOnError="true" />
	</Target>

	<!-- Copy service executable and all its dependencies to UI output directory -->
	<Target Name="CopyServiceExecutable" AfterTargets="Build" DependsOnTargets="BuildServiceProject">
		<ItemGroup>
			<!-- Main service files -->
			<ServiceFiles Include="..\PrintHero.Service\bin\$(Configuration)\net8.0-windows\win-x64\PrintHero.Service.exe" />
			<ServiceFiles Include="..\PrintHero.Service\bin\$(Configuration)\net8.0-windows\win-x64\PrintHero.Service.dll" />
			<ServiceFiles Include="..\PrintHero.Service\bin\$(Configuration)\net8.0-windows\win-x64\PrintHero.Service.deps.json" />
			<ServiceFiles Include="..\PrintHero.Service\bin\$(Configuration)\net8.0-windows\win-x64\PrintHero.Service.runtimeconfig.json" />
		</ItemGroup>
		<Copy SourceFiles="@(ServiceFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(ServiceFiles.FullPath)')" ContinueOnError="true" />
	</Target>

	<!-- Ensure Service project builds first -->
	<Target Name="BuildServiceProject" BeforeTargets="CopyServiceExecutable">
		<MSBuild Projects="..\PrintHero.Service\PrintHero.Service.csproj" Targets="Build" Properties="Configuration=$(Configuration)" ContinueOnError="false" />
	</Target>

	<ItemGroup>
	  <Resource Include="Resources\printhero-logo.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\PrintHero_Logo1.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\PrintHero.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

</Project>
