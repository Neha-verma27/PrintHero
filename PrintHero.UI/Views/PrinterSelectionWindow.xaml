<Window x:Class="PrintHero.UI.Views.PrinterSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Printer" 
        Height="400" 
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card -->
    <Border Background="White" 
            CornerRadius="15" 
            Margin="20" 
            Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Select Printer" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a printer from the list below:" 
                           FontSize="12" 
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Printer List -->
            <Border Grid.Row="1" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1" 
                    CornerRadius="6"
                    Margin="0,0,0,20">
                <ListBox x:Name="PrinterListBox"
                         Background="White"
                         BorderThickness="0"
                         SelectionMode="Single"
                         FontSize="14"
                         Padding="10"
                         MouseDoubleClick="PrinterListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">

                <Button Content="Cancel" 
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#757575"
                        Width="100"
                        Height="35"
                        Margin="0,0,15,0"
                        Click="Cancel_Click"/>

                <Button Content="Select" 
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#4CAF50"
                        Width="100"
                        Height="35"
                        Click="Select_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>