<Window x:Class="PrintHero.UI.Views.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Job Settings" 
        Height="580" 
        Width="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#E5E7EB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Input TextBox Style -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="White" CornerRadius="16" Margin="0,0,0,-6" 
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#9CA3AF" BlurRadius="30" ShadowDepth="8" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="40,25,40,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Print Job Settings" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#111827" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">

                <!-- Job Name -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Job Name" FontSize="14" FontWeight="Medium" 
                               Foreground="#111827" Margin="0,0,0,10"/>
                    <TextBox x:Name="JobNameTextBox" 
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="Job Name" Height="22"/>
                </StackPanel>

                <!-- Hot Folder -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Hot Folder" FontSize="14" FontWeight="Medium" 
                               Foreground="#111827" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="HotFolderTextBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="Hot Folder"
                                 Margin="0,0,20,0"/>
                        <Button Grid.Column="1" Content="Browse" 
                                Style="{StaticResource ButtonStyle}"
                                Background="#6B7280"
                                Width="100" Height="30"
                                Click="BrowseFolder_Click"/>
                    </Grid>
                </StackPanel>

                <!-- File Type -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="File Type" FontSize="14" FontWeight="Medium" 
                               Foreground="#111827" Margin="0,0,0,6"/>
                    <TextBox x:Name="FileTypeTextBox" 
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="PDF"/>
                </StackPanel>

                <!-- Printer Selection -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Printer Selection" FontSize="14" FontWeight="Medium" 
                               Foreground="#111827" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PrinterSelectionTextBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="Printer Selection"
                                 Margin="0,0,20,0"/>
                        <Button Grid.Column="1" Content="Browse" 
                                Style="{StaticResource ButtonStyle}"
                                Background="#6B7280"
                                Width="100" Height="30"
                                Click="BrowsePrinter_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Paper Type and Orientation Row -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paper Type -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Paper Type" FontSize="14" FontWeight="Medium" 
                                   Foreground="#111827" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PaperTypeComboBox" 
                                  Style="{StaticResource ComboBoxStyle}">
                            <ComboBoxItem Content="Paper Type"/>
                            <ComboBoxItem Content="A4"/>
                            <ComboBoxItem Content="A3"/>
                            <ComboBoxItem Content="A5"/>
                            <ComboBoxItem Content="Letter"/>
                            <ComboBoxItem Content="Legal"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Orientation -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Orientation" FontSize="14" FontWeight="Medium" 
                                   Foreground="#111827" Margin="0,0,0,6"/>
                        <ComboBox x:Name="OrientationComboBox" 
                                  Style="{StaticResource ComboBoxStyle}">
                            <ComboBoxItem Content="Portrait"/>
                            <ComboBoxItem Content="Landscape"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Left" Margin="0,25,0,0">
                <Button Content="Run" 
                        Style="{StaticResource ButtonStyle}"
                        Width="100" Height="30"
                        FontSize="12"
                        Margin="0,0,25,0"
                        Click="Save_Click"/>
                <Button Content="Test print" 
                        Style="{StaticResource ButtonStyle}"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Width="100" Height="30"
                        FontSize="12"
                        Margin="0,0,25,0"
                        Click="TestPrint_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Cancel" 
                        Style="{StaticResource ButtonStyle}"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Width="100" Height="30"
                        FontSize="12"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>