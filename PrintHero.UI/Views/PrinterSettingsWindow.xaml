<Window x:Class="PrintHero.UI.Views.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Job Settings" 
        Height="700" 
        Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Control Style -->
        <Style x:Key="InputControlStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputControlStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="12,8,0,8"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <ToggleButton Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Focusable="false"
                                                  IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Width="30">
                                        <Path Fill="#666666" 
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White"
                                            BorderThickness="1"
                                            BorderBrush="#DDDDDD"
                                            CornerRadius="6">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card -->
    <Border Background="White" 
            CornerRadius="15" 
            Margin="20" 
            Padding="40">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Print Job Settings" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                
                <!-- Job Name -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="Job Name:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <TextBox Grid.Column="1" 
                            x:Name="JobNameTextBox"
                            Height="40"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="2"/>
                </Grid>

                <!-- Hot Folder -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="Hot Folder:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <TextBox Grid.Column="1" 
                            x:Name="HotFolderTextBox"
                            Height="40"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="2"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="2" 
                           Content="Browse" 
                           Background="#4285F4" 
                           Foreground="White"
                           Style="{StaticResource DialogButtonStyle}"
                           Height="40"
                           Click="BrowseFolder_Click"/>
                </Grid>

                <!-- File Type -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="File Type:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <TextBox Grid.Column="1" 
                            x:Name="FileTypeTextBox"
                            Text="*.PDF"
                            Height="40"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="2"/>
                </Grid>

                <!-- Separator Line -->
                <Rectangle Height="1" 
                          Fill="#DDDDDD" 
                          Margin="0,0,0,30"/>

                <!-- Printer Selection -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="Printer Selection:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <TextBox Grid.Column="1" 
                            x:Name="PrinterSelectionTextBox"
                            Height="40"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="2"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="2" 
                           Content="Browse" 
                           Background="#4285F4" 
                           Foreground="White"
                           Style="{StaticResource DialogButtonStyle}"
                           Height="40"
                           Click="BrowsePrinter_Click"/>
                </Grid>

                <!-- Printer Status -->
                <Grid Margin="150,5,0,30">
                    <TextBlock Text="Status: Ready" 
                              FontSize="12"
                              Foreground="#4CAF50"
                              FontWeight="Bold"/>
                </Grid>

                <!-- Paper Type and Orientation -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="Paper Type:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <ComboBox Grid.Column="1" 
                             x:Name="PaperTypeComboBox"
                             Height="40"
                             FontSize="14"
                             BorderBrush="#CCCCCC"
                             BorderThickness="2"
                             Margin="0,0,20,0"
                             Style="{StaticResource ComboBoxStyle}">
                        <ComboBoxItem Content="A4"/>
                        <ComboBoxItem Content="A3"/>
                        <ComboBoxItem Content="A5"/>
                        <ComboBoxItem Content="Letter"/>
                        <ComboBoxItem Content="Legal"/>
                        <ComboBoxItem Content="Tabloid"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    
                    <TextBlock Grid.Column="2" 
                              Text="Orientation:" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Foreground="#333333"/>
                    <ComboBox Grid.Column="3" 
                             x:Name="OrientationComboBox"
                             Height="40"
                             FontSize="14"
                             BorderBrush="#CCCCCC"
                             BorderThickness="2"
                             Style="{StaticResource ComboBoxStyle}">
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Landscape"/>
                    </ComboBox>
                </Grid>

            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Test Print button on the left -->
                <Button Grid.Column="0"
                        Content="🖨 Test Print" 
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#FF9800"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Left"
                        Click="TestPrint_Click"/>
                
                <!-- Cancel and Save buttons on the right -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal">
                    <Button Content="← Cancel" 
                            Style="{StaticResource DialogButtonStyle}"
                            Background="#757575"
                            Width="110"
                            Height="40"
                            Margin="0,0,15,0"
                            Click="Cancel_Click"/>

                    <Button Content="💾 Save Settings" 
                            Style="{StaticResource DialogButtonStyle}"
                            Background="#4CAF50"
                            Width="150"
                            Height="40"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>